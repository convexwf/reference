{
  "id": "google-javascript-styleguide",
  "title": "Google JavaScript 风格指南",
  "source": {
    "repository": "https://github.com/zh-google-styleguide/zh-google-styleguide.git",
    "ref": "master"
  },
  "language": "zh-CN",
  "adapter": "google_styleguide",
  "output": "markdown/software-engineering/google-javascript-style-guide.md",
  "front_matter": {
