        {
          "path": "google-javascript-styleguide/index.rst",
          "title": "index"
        },
        {
          "path": "google-javascript-styleguide/background.rst",
          "title": "background"
        },
        {
          "path": "google-javascript-styleguide/javascript_language_rules.rst",
          "title": "javascript language rules"
        },
        {
          "path": "google-javascript-styleguide/javascript_style_rules.rst",
          "title": "javascript style rules"
        }
      ]
    }
  ],
  "completeness": {
    "required_globs": [
      "google-javascript-styleguide/*.rst"
    ],
    "exclude_paths": [
      "google-javascript-styleguide/contents.rst"
    ]
